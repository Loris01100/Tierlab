{
  // Déploiement Cloudflare : `npm run deploy` (build Vite puis wrangler deploy).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainlist",
  "main": "server/worker.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Seules les URL /api/* passent par le Worker ; le reste est servi directement depuis dist/.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Durable Objects (stockage SQLite) : une salle d'édition partagée par lien (LIVE), la galerie communautaire (GALLERY, instance unique).
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "LiveRoom" },
      { "name": "GALLERY", "class_name": "Gallery" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Gallery"] }
  ],
  "routes": [{ "pattern": "mainlist.reesch.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
