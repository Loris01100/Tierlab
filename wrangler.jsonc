{
  // Déploiement Cloudflare : `npm run deploy` (build Vite puis wrangler deploy).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainlist",
  "main": "server/worker.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Seules les URL /api/* passent par le Worker ; le reste est servi directement depuis dist/.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "mainlist.reesch.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
