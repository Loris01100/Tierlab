{
  // Tâches Tierlab. Ctrl+Maj+B : serveur de dev (site + /api) sur http://localhost:5173
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__jamais__$" },
        "background": { "activeBegin": "VITE", "activeEnd": "Local" }
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      // Version de production servie localement sur http://localhost:4173
      "label": "preview",
      "type": "npm",
      "script": "preview",
      "dependsOn": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__jamais__$" },
        "background": { "activeBegin": ".", "activeEnd": "Local" }
      }
    },
    {
      "label": "check",
      "type": "npm",
      "script": "check",
      "problemMatcher": []
    }
  ]
}
